do_backup() {
  local SRC
  local BASENAME
  local DST
  local DST_FULL

  SRC="$1"
  BASENAME="$(basename "${SRC}")"
  DST="${2:-$BASENAME}"
  DST_FULL="${TARGET_DIR}/${CURRENT}/${DST}"

  echo "--------------------------------------------------------"  | tee -a "${LOG}"
  echo "SRC: $SRC"  | tee -a "${LOG}"
  echo "DST: ${DST_FULL}"  | tee -a "${LOG}"
  echo "--------------------------------------------------------"  | tee -a "${LOG}"

  # LOG=$(echo -n $SRC | tr / _ | sed s/^_//).log_${DATE}
  # BACKUP_LOG="${LOG}_$(basename $SRC)_${DATE}.log"

  if [[ -d "${DST_FULL}" ]]; then
    {
      do_sleep "Starting backing up ${SRC} to ${DST_FULL}"
      print_stamp "$SRC"
      EXCLUDE=()

      if [[ -f "${SRC}/${EXCLUDE_FILE}" ]]; then
        EXCLUDE=( "--exclude-from=${SRC}/${EXCLUDE_FILE}" )
      fi

      if is_btrfs "${DST_FULL}"; then
        do_btrfs_snapshot "${DST_FULL}"
        echo "nice rsync -av" "${EXCLUDE[@]}" --delete "${SRC}/" "${DST_FULL}"
        nice rsync -av "${EXCLUDE[@]}" --delete "${SRC}/" "${DST_FULL}"

        touch_stamp "$SRC"
        #sync
      else
        local RSYNC_BACKUP_DIR
        RSYNC_BACKUP_DIR="${BACKUP_ROOT}/${SNAPSHOTS}/${DST}/${DATE}/"
        echo "nice rsync -abv" "${EXCLUDE[@]}" --delete --backup-dir="${RSYNC_BACKUP_DIR}" "${SRC}/" "${DST_FULL}"
        nice rsync -abv "${EXCLUDE[@]}" --delete --backup-dir="${RSYNC_BACKUP_DIR}" "${SRC}/" "${DST_FULL}"
        touch_stamp "$SRC"
        #sync
      fi
    } 2>&1 | tee -a "${LOG}"

# BROKEN    verify_checksums "${DST_FULL}"
  else
    echo "Cannot find ${DST_FULL}. Directory does not exist."  | tee -a "${LOG}"
    exit 1
  fi
  echo "--------------------------------------------------------"  | tee -a "${LOG}"
}

check_disk_space() {
  DU=$(df --output=pcent "${MOUNT_POINT}" | tail -1 | tr -d ' %')
  echo "${DU}% is backup disk (${MOUNT_POINT}) is in use" | tee -a "${LOG}"
  if  (( DU > 90 )); then
    echo "Disk is too full, pls create space" | tee -a "${LOG}"
    exit 3
  fi
}

## main()

if ! check_backup_mount "${MOUNT_POINT}"; then
  mount_backup_disk
fi

for SRC in "${SOURCES[@]}"; do
  do_backup "${SRC}"
done

if [ -n "${UMOUNT}" ]; then
  umount_backup
fi
