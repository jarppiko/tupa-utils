#!/usr/bin/env bash

set -euo pipefail

VERSION="0.2.1"

## Params

CONFIG=~/.config/backup-data
DATE=$(date '+%F'); readonly DATE
LOG="${HOME}/backup-data.log_${DATE}"
CURRENT="current"
SNAPSHOTS="snapshots"
DEVICE=""                   # Empty on purpose, set in CONFIG
PARTITION="1"
IS_LUKS=""
LUKS_DEV="securebackup"
MOUNT_OPTS="nosuid,nodev,noexec"
MOUNT_POINT="/mnt/backup"
TARGET_DIR="${MOUNT_POINT}"
STAMP="last_backup"
EXCLUDE_FILE=".exclude.rsync"
VERBOSE=()
HELP=""
UMOUNT=""

## Functions

help() {
    echo "backup-data [-hu] [-v|q] [-c CONFIG] [-d DEVICE] [-m MOUNT_POINT] [-t TARGET_DIR] SOURCE [SOURCE1..]"
    printf "\nSynchronizes (rsync) SOURCE.. to TARGET_DIR/current and rotates snapshots.\n"
    echo "Uses Btrfs snapshots were available."
    echo -e "\t-h\t\tDisplay help"
    echo -e "\t-q\t\tQuiet operations"
    echo -e "\t-v\t\tVerbose operations"
    echo -e "\t-u\t\tUmount backup disk after backup"
    echo -e "\t-c CONFIG\tConfig file (default $HOME/.config/backup-data)"
    echo -e "\t-d DEVICE\tDevice to mount)"
    echo -e "\t-m MOUNT_POINT\tMount point for DEVICE (default: ${MOUNT_POINT})"
    echo -e "\t-t TARGET_DIR\tTarget dir base for the backups (default: ${TARGET_DIR})"

    echo "Version ${VERSION}"

    exit 0
}

error() {
  MSG="${1}"
  echo "Error: ${MSG}"
  exit 1
}


# shellcheck disable=SC2220
while getopts 'hqvuc:m:t:' option
do
  case "$option" in
    h)
      HELP="yes"
      ;;
    q)
      VERBOSE=(-q)
      ;;
    v)
      VERBOSE=(-v)
      ;;
    u)
      UMOUNT="yes"
      ;;
    c)
      CONFIG="${OPTARG}"
      ;;
    m)
      MOUNT_POINT="${OPTARG}"
      ;;
    t)
      TARGET_DIR="${OPTARG}"
      ;;
  esac
done

# Read config file
if [ -f "${CONFIG}" ]; then
  # shellcheck disable=SC1090
  source "${CONFIG}"
fi

if [ -n "${HELP}" ]; then
  help
fi

# target/source dirs
shift $((OPTIND-1))
SOURCES=( "$@" )

if (( ${#SOURCES[@]} < 1 )); then
  echo "ERROR: Too few parameters"
  help
fi

################################### Subs ##############################################


## Sleep 3 seconds and print "wait dots"
do_sleep() {
  echo -n "$1 "  | tee -a "${LOG}"
  # shellcheck disable=SC2034
  for i in 1 2 3 ; do
    sleep 2s
    echo -n "."  | tee -a "${LOG}"
  done
  echo | tee -a "${LOG}"
}

check_backup_mount() {
  mountpoint -q "$1" && return 0
  >&2 echo "Backup disk ${MOUNT_POINT} is not mounted yet"
  return 1
}


mount_backup_disk() {
  # detect if DEVICE contains a partion table
  if blkid --match-token PTTYPE="gpt" "${DEVICE}"; then
    DEVICE="${DEVICE}${PARTITION}"
  fi

  if cryptsetup isLuks "${DEVICE}"; then
    IS_LUKS="yes"
    {
      cryptsetup "${VERBOSE[@]}" luksOpen "${DEVICE}" "${LUKS_DEV}"
      echo "Mounting ${DEVICE} to ${MOUNT_POINT}"
      mount -o "${MOUNT_OPTS}" "/dev/mapper/${LUKS_DEV}" "${MOUNT_POINT}"
      echo "Device mounted successfully"
    } 2>&1 | tee -a "${LOG}"
  else
    {
      echo "Mounting ${DEVICE} to ${MOUNT_POINT}"
      mount -o "${MOUNT_OPTS}" "${DEVICE}" "${MOUNT_POINT}"
      echo "Device mounted successfully"
    }  2>&1 | tee -a "${LOG}"
  fi
}

umount_backup() {
  # sync

  if mountpoint "${MOUNT_POINT}"; then
    {
      do_sleep "Unmounting now"
      umount "${MOUNT_POINT}"
      echo "  OK"
    } 2>&1 | tee -a "${LOG}"
    if [ -n "${IS_LUKS}" ]; then
      {
        echo -n "Doing luksSuspend ... "
        cryptsetup luksSuspend "${LUKS_DEV}" && echo "OK" || echo "FAILED!!"
        echo -n "Doing luksClose  ... "
        cryptsetup luksClose "${LUKS_DEV}" && echo "OK" || echo "FAILED!!"
      } 2>&1 | tee -a "${LOG}"
    fi
  else
    echo "${MOUNT_POINT} is not mounted"
  fi
}

print_stamp() {
  local STAMP
  STAMP="$(echo "$1" | tr / _ | tr \  _ | sed 's/^_//')"
  STAMP="${TARGET_DIR}/${STAMP}"

  if [[ -f "${STAMP}" ]]; then
    echo "Last backup: $(cat "${STAMP}")" | tee -a "${LOG}"
  fi
}

touch_stamp() {
  local STAMP
  STAMP="$(echo "$1" | tr / _ | tr \  _ | sed 's/^_//')"
  STAMP="${TARGET_DIR}/${STAMP}"

  date > "${STAMP}"
}

do_btrfs_snapshot() {
  local SUBVOL
  local SNAPSHOT_BASE
  SUBVOL="$1"
  SNAPSHOT_BASE="${TARGET_DIR}/${SNAPSHOTS}/$(basename "${SUBVOL}")"

  echo "Creating a snapshot of $SUBVOL" | tee -a "${LOG}"
  if [[ -d "${SNAPSHOT_BASE}" ]]; then
    SNAPSHOT_NAME="@snapshot_$(basename "${SUBVOL}")_${DATE}"
    if [[ -d "${SNAPSHOT_BASE}/${SNAPSHOT_NAME}" ]]; then
      TIME=$(date +%H%M%S)
      mv "${SNAPSHOT_BASE}/${SNAPSHOT_NAME}" "${SNAPSHOT_BASE}/${SNAPSHOT_NAME}_${TIME}" && echo "Old snapshot '${SNAPSHOT_BASE}/${SNAPSHOT_NAME}' renamed"
    fi

    btrfs subvolume snapshot "${SUBVOL}" "${SNAPSHOT_BASE}/${SNAPSHOT_NAME}" || echo "Error in creating btrfs snapshot $SNAPSHOT_NAME"  > /dev/stderr
  else
    echo "Cannot find snapshot base dir: ${SNAPSHOT_BASE}" > /dev/stderr
    exit 5
  fi
}


# Check if filesystem is btrfs
is_btrfs() {
  [ "$(stat -f --print=%T "$1")" == "btrfs" ]
}

